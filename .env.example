# Carregue estas variáveis no processo; scripts/start.sh lê .env.
JWT_SECRET=
TOKEN_TTL_SECONDS=3600
SEED_ADMIN_PASSWORD=
DATABASE_URL='jdbc:h2:file:./data/raizes;DB_CLOSE_ON_EXIT=FALSE;LOCK_TIMEOUT=10000'
DATABASE_PASSWORD=
PORT=8000
SEED_ENABLED=true
# Pedidos não pagos são cancelados após 30 minutos; varredura a cada minuto.
ORDER_RESERVATION_TTL_SECONDS=1800
ORDER_EXPIRATION_SCAN_MS=60000
# Orçamento combinado de login/cadastro por IP de conexão, por janela.
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
