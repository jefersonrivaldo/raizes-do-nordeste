digraph CasosDeUso {
  graph [rankdir=LR, bgcolor="white", pad=0.2, nodesep=0.15, ranksep=0.5];
  node [fontname="DejaVu Sans", fontsize=12, color="#333333"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#555555", dir=none];
  cliente [shape=box, label="«ator»\nCliente\nAPP / WEB / TOTEM / PICKUP"];
  atendente [shape=box, label="«ator»\nAtendente\nBALCAO / unidade vinculada"];
  cozinha [shape=box, label="«ator»\nCozinha\nUnidade vinculada"];
  gerente [shape=box, label="«ator»\nGerente (GERENTE)\nUnidade vinculada"];
  admin [shape=box, label="«ator»\nAdministrador (ADMIN)\nToda a rede"];
  gateway [shape=box, label="«ator de apoio»\nGateway de pagamento\nMock local (simulado)"];
  subgraph cluster_api {
    label="Sistema: API Raízes do Nordeste";
    fontname="DejaVu Sans"; fontsize=14; color="#666666";
    node [shape=ellipse];
    cadastro [label="Cadastrar conta e autenticar\nLimite de requisições por IP"];
    cardapio [label="Consultar cardápio\npor unidade"];
    pedido [label="Realizar pedido multicanal\nValidar e reservar estoque"];
    pagar [label="Solicitar pagamento\nVerificar prazo da reserva"];
    cancelar [label="Cancelar pedido próprio\nainda não pago"];
    status [label="Consultar e atualizar\nstatus operacional"];
    fidelidade [label="Consentir, consultar e\nresgatar pontos"];
    privacidade [label="Desidentificar\nconta própria"];
    estoque [label="Gerenciar estoque e preço\npor unidade"];
    unidade [label="Atualizar dados\nda unidade"];
    gestao [label="Cadastrar unidades e\ngerenciar catálogo e perfis"];
    auditoria [label="Consultar auditoria"];
    regra [shape=note, fontsize=10, label="Regra automática: reserva vencida em\nAGUARDANDO_PAGAMENTO → CANCELADO.\nDevolve estoque uma única vez; restitui pontos\nresgatados se o consentimento permanece ativo."];
    {rank=same; cadastro; cardapio; cancelar; fidelidade; privacidade;}
    {rank=same; pedido; pagar; status; estoque; unidade; gestao; auditoria; regra;}
    cadastro -> pedido [style=invis];
  }
  {rank=same; cliente; atendente; cozinha; gerente; admin;}
  cliente -> cadastro;
  cliente -> cardapio;
  cliente -> pedido;
  cliente -> pagar;
  cliente -> cancelar;
  cliente -> fidelidade;
  cliente -> privacidade;
  atendente -> pedido;
  atendente -> pagar;
  atendente -> status;
  cozinha -> status;
  gerente -> estoque;
  gerente -> unidade;
  admin -> gestao;
  admin -> auditoria;
  pagar -> gateway;
  gerente -> atendente [dir=forward, arrowhead=empty, constraint=false, label="herda operações"];
  admin -> gerente [dir=forward, arrowhead=empty, constraint=false, label="herda operações"];
  // As operações protegidas usam JWT, perfil e unidade. Para legibilidade,
  // autenticação de empregados e consulta de pedidos não repetem associações.
}
