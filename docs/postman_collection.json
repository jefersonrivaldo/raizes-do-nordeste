            "url": "{{baseUrl}}/unidades",
            "description": "Fluxo anterior concluído; resultado esperado HTTP 403",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Unidade teste\",\n  \"endereco\": \"Rua teste, 123\"\n}",
